# Copy to .env on the server (never commit .env)
TZ=UTC
PUID=1000
PGID=1000
MEDIA_PATH=/srv/media
JELLYFIN_CONFIG_PATH=/srv/jellyfin/config
JELLYFIN_CACHE_PATH=/srv/jellyfin/cache
JELLYFIN_PUBLISHED_URL=https://jellyfin.example.com
# Cloudflare Tunnel token (from Zero Trust dashboard) - keep ONLY in .env
CLOUDFLARE_TUNNEL_TOKEN=
DASHBOARD_PORT=8080
